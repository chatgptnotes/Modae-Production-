# Local dev — points at the same Supabase project as the deployed app.
# Gitignored via `.env.*` in .gitignore. Restart `npm run dev` after editing:
# Vite only reads env files at server start.
#
# Both values come from Supabase -> Project Settings -> API.
# The anon key is a publishable client key (it is compiled into the browser
# bundle by design) — it is not the service_role key, which must never go here.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Railway's Express service uses the same project URL server-side.
SUPABASE_URL=
# Server-only Supabase Admin API key. Never prefix this with VITE_ or expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
# AI requests use the same-origin Railway /api/ai route.
# GeoNames username for the worldwide city database. Keep this server-side.
GEONAMES_USERNAME=
