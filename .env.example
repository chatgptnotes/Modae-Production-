# Local dev — Vite exposes only the two VITE_ values to the browser.
# Restart `npm run dev` after editing; Vite reads env files at server start.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only values. Never put real secrets in this file or prefix them with VITE_.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
GEONAMES_USERNAME=
GMAIL_ACCOUNT=
GMAIL_APP_PASSWORD=
RAILWAY_GIT_COMMIT_SHA=
# Legacy-compatible deployment identifiers:
SUPERBEES_GIT_COMMIT_SHA=
