# Copy to .env.local for local development. Never commit a filled-in copy —
# .env and .env.* are gitignored.
#
# Every variable is optional: with none of them set the app runs entirely on
# seeded demo data, files fall back to the in-browser mock, and the AI features
# degrade to their deterministic parsers. That is the behaviour you want on a
# throwaway preview; staging and production should have all of them.

# --- Supabase (shared state + file storage) -------------------------------
# One project per environment. Do NOT point staging at the production project:
# the client uses production live while we keep changing staging.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI (Gemini, via the Vercel serverless function) ----------------------
# Set this in Vercel so the browser uses the server-side Vercel key:
# VITE_AI_FUNCTION_URL=/api/ai (optional; production defaults to this route)
# Local Vite does not serve Vercel functions; use `vercel dev` locally or set
# this to a deployed Vercel URL. The Gemini key itself stays server-side.
VITE_AI_FUNCTION_URL=

# The Gemini key itself is NEVER a VITE_ variable — anything prefixed VITE_ is
# compiled into the browser bundle. It is set on the edge function instead:
#   supabase secrets set GEMINI_API_KEY=... --project-ref <ref>
USE_AI_GATEWAY=true

# --- Gmail (outgoing proposal/RFQ email, via api/send-proposal-email.js) --
# Direct mailbox login over SMTP — no Google Cloud OAuth app needed.
# GMAIL_ACCOUNT is the sending mailbox address. GMAIL_APP_PASSWORD is a
# 16-character app password generated for that account at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# to be enabled on the account).
GMAIL_ACCOUNT=
GMAIL_APP_PASSWORD=
