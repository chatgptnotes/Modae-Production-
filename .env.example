# Local dev — Vite exposes only the two VITE_ values to the browser.
# Restart `npm run dev` after editing; Vite reads env files at server start.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to true only after the server SharePoint configuration and file migration are verified.
VITE_MICROSOFT_GRAPH_ENABLED=false

# Server-only values. Never put real secrets in this file or prefix them with VITE_.
NODE_ENV=development
PORT=3000
CORS_ORIGINS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
GEMINI_API_KEY=
# Optional legacy Gemini fallback until a model is activated in Admin Integrations.
AI_RATE_LIMIT=120
# 32 random bytes encoded as 64 hexadecimal characters or base64. Keep stable.
# Required for Admin Integrations; never use a VITE_ prefix or commit a real value.
INTEGRATIONS_ENCRYPTION_KEY=
# Server-only random signing secret, at least 32 characters; keep stable for backups.
BACKUP_SIGNING_KEY=
# Microsoft 365 Graph gateway. Keep the secret server-only. Supabase Azure Auth
# uses the same Entra application ID/secret configured in its dashboard.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=
MS_SHAREPOINT_SITE_ID=
MS_SHAREPOINT_DRIVE_ID=
MS_SHAREPOINT_ROOT_ITEM_ID=
MS_SHARED_MAILBOX_UPN=
MS_MAIL_WEBHOOK_URL=https://<origin>/api/microsoft-notifications
MS_MAIL_WEBHOOK_SECRET=
GEONAMES_USERNAME=
# Optional, server-only. Enable Google Address Validation API and Geocoding API.
# Separate from Gemini credentials; leave blank to keep advisory validation unavailable.
GOOGLE_MAPS_API_KEY=
GMAIL_ACCOUNT=
GMAIL_APP_PASSWORD=
RAILWAY_GIT_COMMIT_SHA=
# Legacy-compatible deployment identifiers:
SUPERBEES_GIT_COMMIT_SHA=
